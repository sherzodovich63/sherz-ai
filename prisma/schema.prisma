datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ✅ FAZA 4 ENUMS (qo‘shildi)
enum ResponseLengthPref {
  short
  medium
  long
  auto
}

enum TonePref {
  friendly
  minimal_therapy
  neutral
}

enum EnergyPref {
  calm
  energetic
  balanced
}

// --- Mavjud modellar (tartib bilan) ---
model User {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())
  name      String?

  // Google Auth va login uchun shu 3 qator qo'shildi:
  email        String? @unique
  passwordHash String?
  googleId     String? @unique
  avatarUrl    String?

  messages      Message[]
  conversations Conversation[]
  facts         Fact[]

  // ✅ FAZA 4 relations (qo'shildi)
  profile  UserProfile?
  emotions EmotionLog[]

  // ✅ FAZA 6 LAB1: last_state relation (ixtiyoriy)
  brainState BrainState?

  // ✅ SHERZ_HEART v2 relations
  toneEvents      ToneEvent[]
  activitySignals ActivitySignal[]

  // ✅ Work Spaces (qo'shildi)
  workSpaces WorkSpace[]

  // ✅ File tools (Excel/Word/PDF/PowerPoint)
  generatedFiles GeneratedFile[]
}

model Message {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String // "user" | "assistant" | "system"
  text      String
  createdAt DateTime @default(now())

  // null = written before conversations existed (adopted lazily by lib/conversations.js)
  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
  @@index([conversationId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("New chat")
  // "companion" = the user's ONE personal thread; "project" = a focused workspace (Work mode); "space" = WorkSpace thread
  kind      String   @default("companion")
  description String? // project goal / stack, fed to the model in Work mode
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  messages  Message[]

  // ✅ Work Spaces relation (qo'shildi)
  spaceId String?
  space   WorkSpace? @relation(fields: [spaceId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([userId, kind])
  @@index([userId, spaceId])
}

model Fact {
  id        String   @id @default(cuid())
  userId    String
  key       String // masalan: "habit:morning" yoki "note"
  value     String // matn yoki JSON string
  type      String? // "habit" | "preference" | "meta" | ...
  time      String? // "morning", "evening", ...
  rating    Int? // 1 (yoqdi), -1 (yoqmadi), 0 yoki null
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pinned Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 2-bosqich bog'lanmalar:
  tags      FactsOnTags[]
  embedding FactEmbedding?

  @@index([userId, key])
  @@index([updatedAt])
}

// --- 2-bosqich: RAG, Habit analytics, Prefs ---

model FactTag {
  id    String        @id @default(cuid())
  name  String        @unique
  facts FactsOnTags[]
}

model FactsOnTags {
  factId String
  tagId  String

  fact Fact    @relation(fields: [factId], references: [id], onDelete: Cascade)
  tag  FactTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([factId, tagId])
}

model FactEmbedding {
  factId    String   @id
  vector    Bytes // ixtiyoriy: String qilib JSON ham saqlashingiz mumkin
  updatedAt DateTime @updatedAt

  fact Fact @relation(fields: [factId], references: [id], onDelete: Cascade)
}

model HabitEvent {
  id       String   @id @default(cuid())
  userId   String
  habitKey String // masalan: "habit:suv_ichish"
  action   String // 'fired' | 'done' | 'snooze'
  firedAt  DateTime @default(now())

  @@index([userId, habitKey])
  @@index([userId, habitKey, firedAt])
}

model UserPref {
  id        String   @id @default(cuid())
  userId    String
  key       String
  json      String // JSON.stringify({ ... })
  updatedAt DateTime @updatedAt

  @@unique([userId, key])
}

model Todo {
  id        Int      @id @default(autoincrement())
  userId    String
  text      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, done])
}

// ─────────────────────────────
// YANGI MODELLAR: Reminder, MoodEntry, JournalEntry
// ─────────────────────────────

model Reminder {
  id           Int       @id @default(autoincrement())
  userId       String
  text         String
  scheduledFor DateTime
  timezone     String    @default("Asia/Tashkent")
  status       String    @default("pending") // pending | fired | cancelled
  createdAt    DateTime  @default(now())
  firedAt      DateTime?

  @@index([userId])
  @@index([userId, status])
  @@index([scheduledFor])
}

model MoodEntry {
  id       Int      @id @default(autoincrement())
  userId   String
  mood     String
  note     String?
  timezone String   @default("Asia/Tashkent")
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

model JournalEntry {
  id       Int      @id @default(autoincrement())
  userId   String
  title    String?
  text     String
  timezone String   @default("Asia/Tashkent")
  loggedAt DateTime @default(now())

  @@index([userId, loggedAt])
}

// ✅ FAZA 4: UserProfile modeli (yangilandi)
model UserProfile {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  displayName   String?
  preferredName String?

  useNameRate Float @default(0.18) // 0..1

  lengthPref ResponseLengthPref @default(auto)
  tonePref   TonePref           @default(friendly)
  energyPref EnergyPref         @default(balanced)

  // ✅ SHERZ bir marta “Sizni nima deb chaqiray?” so‘raganini eslab qolish
  askedNameAt DateTime?

  // ── SHERZ_HEART v2: Personality baseline (replaces punitive "Hurt" state) ──
  // What kind of bonding style is "normal" for this specific user —
  // detected over time so SHERZ doesn't misread playful roughness as a crisis.
  baselineTone       String? @default("unknown")
  // "playful_aggressive" | "warm_casual" | "formal_transactional" | "unknown"
  baselineConfidence Float   @default(0.0) // 0..1 — gate behavior below 0.4
  baselineSampleSize Int     @default(0) // how many messages informed this baseline

  // ── Tone state: calm, in-the-moment boundary-setting, not silent treatment ──
  toneState       String    @default("warm")
  // "warm" | "neutral" | "guarded" | "direct"
  toneStateSince  DateTime?
  toneStateReason String? // short debug note: what triggered the last shift
  calmTurnStreak  Int       @default(0) // consecutive calm/neutral turns — drives decay back to "warm"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([displayName])
  @@index([preferredName])
  @@index([toneState])
}

// ─────────────────────────────
// ✅ SHERZ_HEART v2: ToneEvent — append-only log of tone_state transitions
// ─────────────────────────────
model ToneEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trigger    String // "harsh_language" | "tension_dissolved" | "manual_reset" | "decay_timeout"
  fromState  String
  toState    String
  messageRef String? // optional: the Message.id that caused this shift
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// ─────────────────────────────
// ✅ SHERZ_HEART v2: ActivitySignal — generic event feed for the proactive engine
// Not just chat timestamps — designed to also ingest future OS-level
// computer-use activity signals (VS Code open late, long focus sessions, etc.)
// ─────────────────────────────
model ActivitySignal {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       String // "message_sent" | "late_night_active" | "long_session" | "os_activity"
  occurredAt DateTime @default(now())
  metadata   Json? // { hour: 1, durationMinutes: 95, app: "vscode", ... }

  @@index([userId, occurredAt])
  @@index([userId, kind, occurredAt])
}

// ✅ EmotionLog: relation + index (yangilandi, qolgan fieldlar o‘sha)
model EmotionLog {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  emotion   String // sad, stressed, calm, happy...
  score     Int // -3 → +3
  reason    String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, createdAt])
}

// ─────────────────────────────
// ✅ FAZA 6 LAB1: BrainState (last_state 100%)
// ─────────────────────────────
model BrainState {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  lastSkill  String?
  lastArgs   Json?
  lastResult Json?

  status String @default("idle") // idle | pending | done | failed

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([updatedAt])
}

model ProfileSummaryCache {
  userId             String    @id
  summary            String
  latestFactAt       DateTime?
  latestEmotionLogAt DateTime?
  updatedAt          DateTime  @updatedAt
}

// ─────────────────────────────
// ✅ FAZA 6 LAB5/LAB6: ProactiveEvent (LAB6 fieldlar qo‘shildi)
// ─────────────────────────────
model ProactiveEvent {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  // (optional) event type for analytics
  kind String? // proactive | permission | soft_presence | boundary_respect | proactive_skip

  // decision log
  shouldMessage Boolean
  reason        String?
  tone          String?
  message       String?

  // delivery
  sentAt    DateTime?
  delivered Boolean   @default(false)

  // feedback
  gotReply      Boolean   @default(false)
  replyAt       DateTime?
  replyLatencyS Int?

  // context snapshot
  hourLocal Int?
  dayOfWeek Int?

  // ✅ LAB6: reply boundary tracking
  awaitingReply   Boolean   @default(false)
  replyDeadlineAt DateTime?

  noReplyCause      String? // busy | avoiding | overwhelmed
  noReplyConfidence Float? // 0..1
  boundaryDecision  String? // normal | soft_presence | respect

  permissionAsked  Boolean @default(false)
  permissionResult String? // granted | deny | no_answer

  softPresenceSent Boolean   @default(false)
  respectUntil     DateTime?

  metaJson Json?

  @@index([userId, createdAt])
  @@index([userId, delivered, gotReply])
  @@index([userId, awaitingReply, replyDeadlineAt])
}

// ─────────────────────────────
// ✅ FAZA 6 LAB5/LAB6: UserProactivePolicy (LAB6 fieldlar qo‘shildi)
// ─────────────────────────────
model UserProactivePolicy {
  userId    String   @id
  updatedAt DateTime @updatedAt

  // existing knobs (qoladi, eski kodlar sinmasin)
  cooldownMinutes Int @default(120)
  maxPerDay       Int @default(4)

  toneWeights  Json?
  hourPenalty  Json?
  blockedHours Json?

  // ✅ LAB6 knobs
  enabled Boolean @default(true)

  // ✅ SHERZ_HEART v2: user-controlled snooze for late-night check-ins etc.
  // Distinct from `respectModeUntil` (system-driven) — this is user-initiated.
  proactiveMuteUntil DateTime?

  softPresenceCooldownHours Int @default(12)
  respectCooldownHours      Int @default(24)

  permissionSensitivity Int @default(2)
  // 0=never ask, 1=sometimes, 2=often(default), 3=always before soft_presence

  lastSoftPresenceAt DateTime?
  respectModeUntil   DateTime?

  busyScore        Float @default(0)
  avoidingScore    Float @default(0)
  overwhelmedScore Float @default(0)

  @@index([updatedAt])
}

// ✅ Proactive Inbox queue (backend → frontend pipeline)

enum InboxStatus {
  PENDING
  SENT
  READ
  ARCHIVED
}

model ProactiveInbox {
  id        String      @id @default(cuid())
  userId    String
  type      String // "EMOTION_TREND" | "INACTIVITY" | ...
  title     String?
  body      String
  priority  Int         @default(5) // 1 = high, 10 = low
  status    InboxStatus @default(PENDING)

  // dedupe: bir xil trigger qayta-qayta spam bo'lmasin
  dedupeKey String?
  meta      Json?

  scheduledFor DateTime?
  sentAt       DateTime?
  readAt       DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId, status, createdAt])
  @@index([userId, dedupeKey])
}

// ─────────────────────────────────────────────────────────────────────────────
// Work Spaces + Skills (Phase 4)
// ─────────────────────────────────────────────────────────────────────────────

model WorkSpace {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  role         String? // one line: who the AI should be here
  preset       String         @default("blank") // blank | dispatcher | student | developer
  style        String         @default("general") // general | engineering  (which Work-mode block is used)
  icon         String         @default("briefcase")
  color        String         @default("violet")
  instructions String         @default("") // user-written, max 2000 chars
  tools        Json           @default("{}")
  templates    Json           @default("[]")
  archivedAt   DateTime?
  role2         Json     @default("{}")
  activeRole    Int      @default(1)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  conversations Conversation[]
  skills       Skill[]
  
  @@unique([userId, name])
  @@index([userId, archivedAt])
}

model Skill {
  id          String       @id @default(cuid())
  userId      String
  spaceId     String
  space       WorkSpace    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name        String
  summary     String
  body        String
  triggers    Json         @default("[]")
  source      String       @default("taught") // taught | researched | observed
  sourceRefs  Json         @default("[]")
  status      String       @default("active") // draft | active | archived
  version     Int          @default(1)
  uses        Int          @default(0) // plans this skill informed
  successes   Int          @default(0)
  corrections Int          @default(0)
  rejections  Int          @default(0)
  lastUsedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  events      SkillEvent[]

  @@unique([spaceId, name])
  @@index([userId, spaceId, status])
}

model SkillEvent {
  id      String   @id @default(cuid())
  userId  String
  skillId String
  skill   Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  type    String // created | edited | used | success | corrected | rejected | thumbs_up | thumbs_down
  ref     String? // the AgentAction id a "used" event belongs to
  at      DateTime @default(now())

  @@index([skillId, at])
  @@index([ref, type])
}

// ─────────────────────────────────────────────────────────────────────────────
// File tools: generated / uploaded Excel, Word, PDF, PowerPoint files
// ─────────────────────────────────────────────────────────────────────────────

model GeneratedFile {
  id        String   @id @default(cuid())
  userId    String
  name      String
  mime      String
  size      Int
  source    String   @default("generated") // generated | uploaded
  bytes     Bytes
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ── Shared learning (opt-in) ──
model SharedSolution {
  id              String    @id @default(cuid())
  roleGroup       String    // "dispatcher" | "developer" | "analyst"
  lang            String    @default("en")
  problem         String    // anonymized, general description of the problem
  keywords        String    @default("") // lower-case words, space separated (fallback search)
  solution        String    // anonymized, general method that worked
  conditions      String    @default("") // when it applies / does not apply
  embedding       Json?     // number[] of the problem (cosine search)
  status          String    @default("candidate") // candidate | trusted | hidden
  confirmCount    Int       @default(0) // distinct users who said it worked
  failCount       Int       @default(0) // distinct users who said it did not
  lastConfirmedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  confirmations   SolutionConfirmation[]

  @@index([roleGroup, status])
  @@index([updatedAt])
}

model SolutionConfirmation {
  id         String   @id @default(cuid())
  solutionId String
  userHash   String   // salted hash of the user id — never the id itself
  outcome    String   // "worked" | "failed"
  createdAt  DateTime @default(now())

  solution   SharedSolution @relation(fields: [solutionId], references: [id], onDelete: Cascade)

  @@unique([solutionId, userHash])
  @@index([userHash])
}

// ── Web Push subscriptions ──
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String    @default("")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
}
