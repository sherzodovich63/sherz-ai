{
  "name": "sherz-desktop",
  "productName": "SHERZ",
  "version": "0.1.0",
  "description": "SHERZ for Windows, macOS and Linux",
  "author": "SHERZ AI",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win --publish never",
    "build:exe": "electron-builder --win nsis --x64 --publish never",
    "release:win": "electron-builder --win nsis --x64 --publish always",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "icons": "electron src/make-icons.cjs",
    "web-icons": "electron src/make-web-icons.cjs",
    "debug": "electron . --sherz-debug"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
