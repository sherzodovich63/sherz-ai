{
  "name": "sherz-mobile",
  "private": true,
  "version": "0.1.0",
  "description": "SHERZ for iOS and Android (Capacitor \u2014 the same web app inside a native shell)",
  "type": "module",
  "scripts": {
    "init": "node scripts/init.mjs",
    "sync": "cap sync",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor \"#2f3cc8\" --splashBackgroundColor \"#070709\"",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "apk": "cd android && ./gradlew assembleDebug",
    "apk:release": "cd android && ./gradlew assembleRelease",
    "test": "node --test scripts/*.test.mjs",
    "assets:android": "capacitor-assets generate --android --iconBackgroundColor \"#2f3cc8\" --splashBackgroundColor \"#070709\""
  },
  "dependencies": {
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/browser": "^6.0.3",
    "@capacitor/core": "^6.2.0",
    "@capacitor/filesystem": "^6.0.2",
    "@capacitor/ios": "^6.2.0",
    "@capacitor/local-notifications": "^6.1.1",
    "@capacitor/network": "^6.0.3",
    "@capacitor/push-notifications": "^6.0.3",
    "@capacitor/share": "^6.0.3",
    "@capacitor/splash-screen": "^6.0.3",
    "@capacitor/status-bar": "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.0"
  }
}
